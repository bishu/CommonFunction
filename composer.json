{
    "name": "bishu/common-function",
    "description": "Simple reusable common functions for PHPMaker 2026 projects.",
    "type": "library",
    "license": "proprietary",
    "require": {
        "php": ">=8.2",
        "monolog/monolog": "^3.0",
        "endroid/qr-code": "^6.0"
    },
    "autoload": {
        "files": [
            "src/Internal.php",
            "src/String.php",
            "src/Validation.php",
            "src/Api.php",
            "src/Image.php",
            "src/Network.php",
            "src/Logging.php",
            "src/Session.php",
            "src/Captcha.php",
            "src/Payment.php",
            "src/Html.php"
        ]
    },
    "config": {
        "sort-packages": true
    }
}
